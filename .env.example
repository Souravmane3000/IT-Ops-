# OpenAI (required for agent LLM calls)
OPENAI_API_KEY=

# Domain SQLite database
IT_OPS_DB_PATH=./data/it_ops.db

# LangGraph checkpoint SQLite database
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Frontend → FastAPI base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Playwright browser target (Next.js app)
PLAYWRIGHT_BASE_URL=http://localhost:3000

# false = headed browser for demo; true = headless for tests
PLAYWRIGHT_HEADLESS=false

# CORS origins for FastAPI (comma-separated)
CORS_ORIGINS=http://localhost:3000

# LangSmith observability (optional — app works without these)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=it-ops

# OpenAI model (optional override)
OPENAI_MODEL=gpt-4o-mini
